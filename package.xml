<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/blog" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/blog" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="content.blog-publishing">
                <title>Blog publishing</title>
                <description>
                    Provides blog lists and entries with configurable presentation, publication dates, pinned posts,
                    author attribution, guest authors, article navigation, and structured BlogPosting data.
                </description>
            </capability>

            <capability id="engagement.blog-comments">
                <title>Blog comments</title>
                <description>
                    Adds configurable Disqus or Facebook comments to blog entries, with project-wide settings and
                    per-entry activation controls.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/blog/bin/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/blog/bin/images/preview/1.jpg"/>
            <image src="URL_OPT_DIR/quiqqer/blog/bin/images/preview/2.jpg"/>
            <image src="URL_OPT_DIR/quiqqer/blog/bin/images/preview/3.jpg"/>
            <image src="URL_OPT_DIR/quiqqer/blog/bin/images/preview/4.jpg"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/blog]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/blog/issues]]></issues>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>
    </package>
</quiqqer>
